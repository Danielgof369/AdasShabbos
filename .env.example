# Database — Postgres connection string (Neon / Supabase / Vercel Postgres).
# For laptop-only tinkering without a database, flip the provider in
# prisma/schema.prisma to "sqlite" and use DATABASE_URL="file:./dev.db".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base URL used in reminder links (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Admin dashboard password
ADMIN_PASSWORD="change-me"

# Secret required to invoke the cron reminder endpoints
CRON_SECRET="change-me-too"

# --- Messaging providers (all optional; console logging is the fallback) ---

# Twilio (SMS, and WhatsApp once your sender is approved)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""        # e.g. +13105551234
TWILIO_WHATSAPP_FROM=""      # e.g. whatsapp:+13105551234 (leave empty to disable)

# Resend (email) — free tier is plenty at shul scale
RESEND_API_KEY=""
EMAIL_FROM="Elul Shabbos Project <shabbos@adastorah.org>"
