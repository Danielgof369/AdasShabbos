generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon). For local testing without a database, flip provider to
// "sqlite" and set DATABASE_URL="file:./dev.db".
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ v2: multi-tenant ============
// One row per community. Each shul lives at <slug>.<ROOT_DOMAIN> (or its own
// customDomain) and owns its households, commitment list, and raffle draws.
model Shul {
  id           String  @id @default(cuid())
  slug         String  @unique // subdomain, e.g. "adas"
  customDomain String? @unique // e.g. "shabboswithadas.com"
  name         String // "Adas Torah"
  partnerName  String? // co-branded partner, e.g. "LINK Kollel"
  city         String  @default("Los Angeles")
  state        String? // "CA" — groups the national directory

  // The person who set the shul up (gets the welcome + platform emails).
  contactName  String?
  contactEmail String?

  campaignName String @default("Kabalos Shabbos") // shown in the header
  seasonLabel  String @default("Elul 5786") // hero kicker, e.g. "Elul 5786"

  // Optional program features — each shul turns these on or off.
  pledgeEnabled   Boolean @default(true)
  charityName     String  @default("Tomchei Shabbos")
  pledgePerSignup Int     @default(5) // dollars per family signup
  raffleEnabled   Boolean @default(true)
  rafflePrize     String  @default("pizza party") // "…entered to win a {prize}"

  // Optional custom copy. Blank = the platform's default text.
  whyText String? // "Why we're doing this" — paragraphs separated by blank lines

  // Homepage announcement popup (shown once per device per update).
  announcementTitle     String?
  announcementBody      String?
  announcementUrl       String?
  announcementUpdatedAt DateTime?

  // Campaign calendar: comma-separated Shabbos dates + the shul's timezone.
  shabbosDates String // "2026-08-22,2026-08-29,2026-09-05,2026-09-19"
  tzOffset     String @default("-07:00") // UTC offset during the campaign
  timezone     String @default("America/Los_Angeles") // IANA, for labels

  // Branding: paths (files in /public) or absolute URLs. Null = text wordmark.
  logoLight        String? // shul logo on light backgrounds
  logoDark         String? // shul logo on the navy header/hero
  partnerLogoLight String?
  partnerLogoDark  String?

  // true = the shul runs its own site (subdomain/custom domain + admin).
  // false = a shul families named when signing up on the national site;
  // it lives at kabbolasshabbos.com/s/<slug> and has no admin yet.
  hasSite   Boolean @default(true)
  adminHash String // sha256("elul:<slug>:<password>") — per-shul admin login
  active    Boolean  @default(true) // false = site off (platform admin switch)
  approved  Boolean  @default(false) // self-serve shuls wait for the operator's OK
  listed    Boolean  @default(true) // show in the national directory
  createdAt DateTime @default(now())

  households  Household[]
  suggestions Suggestion[]
  raffleDraws RaffleDraw[]
  resources   Resource[]
  assets      ShulAsset[]
}

// Uploaded images (logos) — served at /api/logo/<id>. Kept out of the Shul
// row so tenant lookups stay light.
model ShulAsset {
  id        String   @id @default(cuid())
  shulId    String
  kind      String // "logoDark" | "logoLight" | "partnerLogoDark" | "partnerLogoLight"
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  shul Shul @relation(fields: [shulId], references: [id], onDelete: Cascade)

  @@index([shulId])
}

// Downloadable/linkable resources a shul offers (PDFs, divrei Torah, guides).
model Resource {
  id          String   @id @default(cuid())
  shulId      String
  kicker      String? // small label, e.g. "Dvar Halacha" / "For Children"
  title       String
  byline      String? // "by Rabbi …"
  description String?
  url         String // /file.pdf in /public, or an absolute URL
  emoji       String   @default("📄")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  shul Shul @relation(fields: [shulId], references: [id], onDelete: Cascade)

  @@index([shulId])
}

// A household is the unit that signs up: one contact set, one or more people.
model Household {
  id         String   @id @default(cuid())
  shulId     String
  token      String // personal check-in link slug, unique within the shul
  familyName String? // "Gofman" -> shown as "The Gofman Family"
  phone      String?
  email      String?
  email2     String? // additional reminder recipients (e.g. both parents)
  email3     String?
  createdAt  DateTime @default(now())

  smsOptIn   Boolean @default(true)
  emailOptIn Boolean @default(true)

  shul    Shul     @relation(fields: [shulId], references: [id], onDelete: Cascade)
  members Member[]

  @@unique([shulId, token])
  @@index([shulId, phone])
  @@index([shulId, email])
}

// A member is a person taking on commitments (parent, child, etc.)
model Member {
  id          String  @id @default(cuid())
  householdId String
  name        String
  isChild     Boolean @default(false)
  gender      String? // "man" | "woman" | "boy" | "girl" — drives avatars

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goals     Goal[]

  @@index([householdId])
}

// The catalog of things people can take on — per shul, editable by its admin.
model Suggestion {
  id        String  @id @default(cuid())
  shulId    String
  title     String
  detail    String?
  // unitLabel/unitValue drive the homepage highlight reel
  unitLabel String
  unitValue Int     @default(1)
  // audience: "adult" | "child" | "both" (legacy CSVs tolerated)
  categories String @default("both")
  // "individual" (one person), "family" (the household together),
  // "kehilla" (the shul as a whole — shown on the shul page, not in signup)
  tier       String @default("individual")
  sortOrder  Int    @default(0)
  active     Boolean @default(true)

  shul  Shul   @relation(fields: [shulId], references: [id], onDelete: Cascade)
  goals Goal[]

  @@index([shulId])
}

// One member's commitment for one week of the campaign.
model Goal {
  id           String   @id @default(cuid())
  memberId     String
  week         Int // 1-based campaign week
  suggestionId String?
  customTitle  String? // if they wrote in their own commitment
  createdAt    DateTime @default(now())

  checkedInAt DateTime? // set when they confirm they did it

  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  suggestion Suggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  @@index([memberId, week])
  @@index([week])
}

// One pizza-raffle winner per shul per week.
model RaffleDraw {
  id          String   @id @default(cuid())
  shulId      String
  week        Int
  householdId String
  familyName  String
  drawnAt     DateTime @default(now())

  shul Shul @relation(fields: [shulId], references: [id], onDelete: Cascade)

  @@unique([shulId, week])
}

// Platform-wide key/value settings edited at /platform (national season).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Log of every reminder sent, for admin visibility and dedupe.
// Household ids are globally unique, so this needs no shul column.
model MessageLog {
  id          String   @id @default(cuid())
  householdId String
  kind        String // "thursday_reminder" | "checkin_reminder" | ...
  channel     String // "sms" | "email" | "whatsapp" | "console"
  week        Int
  sentAt      DateTime @default(now())

  @@index([householdId, kind, week])
}
